{
  "name": "whilter-platform-frontend",
  "version": "1.5.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "turbo run dev --concurrency 11",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "ui-kit": "pnpm --filter @whilter/ui-kit",
    "type-check": "turbo type-check",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@whilter/api": "workspace:*",
    "@whilter/auth": "workspace:*",
    "@whilter/eslint-config": "workspace:*",
    "@whilter/typescript-config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "prettier": "catalog:",
    "turbo": "2.1.1"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.17.0"
  },
  "volta": {
    "node": "20.17.0",
    "pnpm": "9.12.0"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/roboto": "^5.2.5",
    "@mui/icons-material": "^6.4.7",
    "@mui/material": "^6.4.7",
    "@mui/material-nextjs": "^7.3.0",
    "@mui/x-date-pickers": "^7.28.0",
    "@reduxjs/toolkit": "^2.6.1",
    "@wavesurfer/react": "^1.0.11",
    "axios": "^1.9.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "formik": "^2.4.6",
    "framer-motion": "^12.4.11",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.17.21",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^0.479.0",
    "next-auth": "^4.24.11",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.58.1",
    "react-icons": "^5.5.0",
    "react-select": "^5.10.1",
    "react-table": "^7.8.0",
    "recharts": "^3.1.2",
    "sass": "^1.86.0",
    "sonner": "^2.0.6",
    "wavesurfer.js": "^7.9.9",
    "yup": "^1.6.1"
  },
  "sideEffects": false,
  "type": "module"
}
