# nginx.conf
events {
    worker_connections 1024;
}

http {
    # Main App - app.example.com:3000
    server {
        listen 80;
        server_name app.example.com;
        
        location / {
            proxy_pass http://main-app:3000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }

    # Media Tools - media.example.com:3001
    server {
        listen 80;
        server_name media.example.com;
        
        location / {
            proxy_pass http://media-tools:3001;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }

    # Charp AI - ai.example.com:3002
    server {
        listen 80;
        server_name ai.example.com;
        
        location / {
            proxy_pass http://charp-ai:3002;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }

    # Marketplace - market.example.com:3003
    server {
        listen 80;
        server_name market.example.com;
        
        location / {
            proxy_pass http://marketplace:3003;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}