{
  "extends": "@whilter/typescript-config/react-library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
  "@whilter/shared-types": ["../shared-types/src/index.ts"],
  "@whilter/shared-types/*": ["../shared-types/src/*"]
  }
},
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "index.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}