{
  "extends": "@whilter/typescript-config/react-library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
  "@whilter/shared-hooks": ["src/index.tsx"],
  "@whilter/shared-hooks/*": ["../shared-hooks/src/*"]
}
  },
  "include": [
  "src/**/*.ts",
  "src/**/*.tsx"
],
  "exclude": [
    "node_modules"
  ]
}